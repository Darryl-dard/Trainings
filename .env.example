NODE_ENV=development
PORT=3005
# Port hôte du conteneur app (défaut : 3005)
APP_PORT=3005

# Lu par Docker Compose (service db)
POSTGRES_USER=orvane
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orvane
POSTGRES_PORT=5432

# Lu par l'application. Doit rester cohérent avec les valeurs POSTGRES_* ci-dessus
DATABASE_URL=postgresql://orvane:change-me@localhost:5432/orvane

# Base dédiée aux tests e2e (le nom DOIT finir par _test)
TEST_DATABASE_URL=postgresql://orvane:change-me@localhost:5432/orvane_test